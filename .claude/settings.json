{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mvn -v)",
      "Bash(mvn -Dmaven.compiler.proc=full -DskipTests compile)",
      "Bash(mvn -Dmaven.compiler.proc=full -DskipTests test-compile)",
      "Bash(mvn -Dmaven.compiler.proc=full test)",
      "Bash(mvn -Dmaven.compiler.proc=full -Dtest=* test)",
      "Bash(mvn clean)",
      "Bash(JAVA_HOME=\"/c/Program Files/Java/jdk-25.0.3\" mvn -Dmaven.compiler.proc=full -DskipTests compile)",
      "Bash(JAVA_HOME=\"/c/Program Files/Java/jdk-25.0.3\" mvn -Dmaven.compiler.proc=full test)",
      "Bash(JAVA_HOME=\"/c/Program Files/Java/jdk-25.0.3\" mvn -Dmaven.compiler.proc=full -Dtest=* test)",
      "PowerShell(mvn -v)",
      "PowerShell(mvn -Dmaven.compiler.proc=full -DskipTests compile)",
      "PowerShell(mvn -Dmaven.compiler.proc=full -DskipTests test-compile)",
      "PowerShell(mvn -Dmaven.compiler.proc=full test)",
      "PowerShell(mvn -Dmaven.compiler.proc=full -Dtest=* test)",
      "PowerShell(mvn clean)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git ls-files *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)",
      "PowerShell(git ls-files *)",

      "Bash(rg *)",
      "Bash(tree *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-Location)",
      "PowerShell(Test-Path *)",
      "PowerShell(Get-Service *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/application-prod.properties)",
      "Read(**/application-prod.yml)",
      "Read(**/application-prod.yaml)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.jks)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",

      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "PowerShell(git push *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(Remove-Item *-Recurse*)"
    ],
    "ask": [
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch --delete *)",

      "Bash(docker *)",
      "Bash(docker-compose *)",
      "PowerShell(docker *)",
      "PowerShell(docker-compose *)"
    ]
  }
}
